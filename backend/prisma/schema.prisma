generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String   @unique
  criadaEm DateTime @default(now()) @map("criada_em")

  @@map("categorias")
}
