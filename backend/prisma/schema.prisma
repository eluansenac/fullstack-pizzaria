generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String   @unique
  criadaEm DateTime @default(now()) @map("criada_em")

  @@map("categorias")
}

enum Perfil {
  ADMIN
  CLIENTE
}

model Usuario {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  perfil    Perfil   @default(CLIENTE)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("usuarios")
}
